
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TourStatus {
  DRAFT
  PUBLISHED
}

enum CheckpointPriceKind {
  TICKET
  FOOD
}

enum Role {
  ANONYMOUS
  ADMIN
}

enum ContentType {
  TEXT
  HTML
}

enum PrivateTourStatus {
  DRAFT
  ACTIVE
  REVOKED
}

model Tour {
  id           String            @id @default(cuid())
  slug         String            @unique
  status       TourStatus        @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations TourTranslation[]
  checkpoints  TourCheckpoint[]
  progress     TourProgress[]
}

model TourTranslation {
  id            String  @id @default(cuid())
  tourId        String
  tour          Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  locale        String
  name          String
  tagline       String
  description   String
  coverImageUrl String

  @@unique([tourId, locale])
}

model Checkpoint {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  latitude              Float
  longitude             Float
  radiusMeters          Int                     @default(100)
  estimatedVisitMinutes Int                     @default(30)
  sortOrderHint         Int                     @default(0)
  priceVnd              Int?
  priceKind             CheckpointPriceKind     @default(TICKET)
  translations          CheckpointTranslation[]
  images                CheckpointImage[]
  guides                GuideSection[]
  tourLinks             TourCheckpoint[]
  checkIns              CheckIn[]
  privateStops          PrivateTourStop[]
}

model CheckpointTranslation {
  id              String     @id @default(cuid())
  checkpointId    String
  checkpoint      Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  locale          String
  name            String
  summary         String
  address         String
  openingHours    String?
  bestTimeToVisit String?

  @@unique([checkpointId, locale])
}

model GuideSection {
  id           String      @id @default(cuid())
  checkpointId String
  checkpoint   Checkpoint  @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  locale       String
  content      String
  contentType  ContentType @default(HTML)
  sortOrder    Int         @default(0)

  @@unique([checkpointId, locale])
}

model CheckpointImage {
  id           String     @id @default(cuid())
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  sortOrder    Int        @default(0)
  isThumbnail  Boolean    @default(false)
}

model TourCheckpoint {
  id           String     @id @default(cuid())
  tourId       String
  tour         Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  order        Int

  @@unique([tourId, checkpointId])
  @@unique([tourId, order])
}

model User {
  id                    String    @id @default(cuid())
  /// Anonymous visitor identity key (ctm_visitor cookie); null for seeded admin until first visit action.
  visitorKey            String?   @unique
  role                  Role      @default(ANONYMOUS)
  email                 String?   @unique
  passwordHash          String?
  /// SHA-256 of the rotating admin session token (ctm_admin cookie) — ADR-0001.
  adminSessionTokenHash String?   @unique
  adminSessionExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  checkIns              CheckIn[]
  progress              TourProgress[]
}

model TourProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tourId      String
  tour        Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, tourId])
}

model CheckIn {
  id                     String     @id @default(cuid())
  userId                 String
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpointId           String
  checkpoint             Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  latitude               Float
  longitude              Float
  accuracy               Float
  distanceFromCheckpoint Float
  checkedInAt            DateTime   @default(now())
  shareLink              ShareLink?

  @@unique([userId, checkpointId])
}

model ShareLink {
  id        String   @id
  checkInId String   @unique
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ── Private tours (ADR-0006) ────────────────────────────────────────────────
// A per-customer run composed from the same Checkpoints as public tours. Not
// derived from Tour: unlisted, code-addressed, revocable, expiring, and with no
// progress/unlock chain (ADR-0002 deliberately does not apply here).

model PrivateTour {
  id            String   @id @default(cuid())
  /// 8 chars from an alphabet with no look-alike glyphs, for dictation by phone.
  code          String   @unique
  /// Second authorization factor, stored normalized (see normalizePhone).
  customerPhone String
  customerName  String?
  status        PrivateTourStatus @default(DRAFT)
  startsAt      DateTime?
  /// null = never expires
  expiresAt     DateTime?
  maxSlots      Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translations PrivateTourTranslation[]
  stops        PrivateTourStop[]
  accesses     PrivateTourAccess[]
  visits       PrivateTourVisit[]

  @@index([status])
}

model PrivateTourTranslation {
  id            String      @id @default(cuid())
  privateTourId String
  privateTour   PrivateTour @relation(fields: [privateTourId], references: [id], onDelete: Cascade)
  locale        String
  name          String
  tagline       String
  description   String
  coverImageUrl String

  @@unique([privateTourId, locale])
}

/// Mirror of TourCheckpoint: `order` is 1-based and the array order is the
/// visit order (ADR-0004). Separate table because it is FK-bound to its tour.
model PrivateTourStop {
  id            String      @id @default(cuid())
  privateTourId String
  privateTour   PrivateTour @relation(fields: [privateTourId], references: [id], onDelete: Cascade)
  checkpointId  String
  checkpoint    Checkpoint  @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  order         Int

  @@unique([privateTourId, checkpointId])
  @@unique([privateTourId, order])
}

/// One row per successful unlock — the slot unit. Not a person: there is no
/// customer login, so identity is only the opaque ctm_private cookie key.
model PrivateTourAccess {
  id            String      @id @default(cuid())
  privateTourId String
  privateTour   PrivateTour @relation(fields: [privateTourId], references: [id], onDelete: Cascade)
  sessionKey    String
  firstAccessAt DateTime    @default(now())

  @@unique([privateTourId, sessionKey])
}

/// Proximity record from the "Tôi đã tới" action. Deliberately NOT a CheckIn
/// or TourProgress: a private tour records that someone was nearby, nothing more.
model PrivateTourVisit {
  id            String      @id @default(cuid())
  privateTourId String
  privateTour   PrivateTour @relation(fields: [privateTourId], references: [id], onDelete: Cascade)
  sessionKey    String
  checkpointId  String
  visitedAt     DateTime    @default(now())

  @@unique([privateTourId, sessionKey, checkpointId])
}
