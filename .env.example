# PostgreSQL connection string.
# Production: Neon pooled connection string (https://neon.tech) with sslmode=require.
# Local dev: Docker `postgres:16` (see README).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cham_tren_map"

# MapLibre style URL (OpenStreetMap-compatible tiles / style provider).
# Leave empty to use the built-in OpenStreetMap raster style.
NEXT_PUBLIC_MAP_STYLE_URL=

# Canonical origin used for share links and Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial admin credentials used by `prisma db seed`.
# Only the bcrypt password hash is stored in the database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
