# PostgreSQL connection string.
# Production: Neon pooled connection string (https://neon.tech) with sslmode=require.
# Local dev: Docker `postgres:16` (see README).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cham_tren_map"

# Google Maps Platform key with Maps JavaScript API + Directions API enabled.
# Restrict the key to your domains before production.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps Map ID (Vector) — required for AdvancedMarker status pins.
# Create at console.cloud.google.com → Google Maps Platform → Map Management.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Canonical origin used for share links and Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

