# PostgreSQL connection string.
# Production: Neon pooled connection string (https://neon.tech) with sslmode=require.
# Local dev: Docker `postgres:16` (see README).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cham_tren_map"

# MapLibre style URL (OpenStreetMap-compatible tiles / style provider).
# Empty = built-in standard OpenStreetMap raster layer
# (https://tile.openstreetmap.org/{z}/{x}/{y}.png): free, no key, no account.
# OSM's community tiles are for low-volume use — point this at a commercial
# provider or a self-hosted style for real traffic:
#   https://tiles.openfreemap.org/styles/liberty
#   https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional: time budget (ms) for one map-load attempt. When it lapses without a
# `load` event — or when tiles fail with none ever rendering — the map silently
# retries once on the built-in CARTO raster tiles (a different host) and then
# shows a retry UI. Default: 20000.
# NEXT_PUBLIC_MAP_LOAD_TIMEOUT_MS=20000

# Canonical origin used for share links and Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial admin credentials used by `prisma db seed`.
# Only the bcrypt password hash is stored in the database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
